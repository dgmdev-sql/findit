# FindIt environment variables template (copy to .env for local development)

# PostgreSQL Container Configuration
POSTGRES_DB=findit
POSTGRES_USER=findit_user
POSTGRES_PASSWORD=change_me_in_production

# Flask Microservices Database Connection
DB_HOST=db
DB_PORT=5432
DB_NAME=findit
DB_USER=findit_user
DB_PASSWORD=change_me_in_production

# Image Tag / Build Number (Overridden automatically by Jenkins BUILD_NUMBER)
TAG=latest
